{:paths ["src/cljc"]
 :deps {}
 :aliases {:dev {:extra-paths ["dev/cljc" "dev/clj"]}
           :test {:extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                               io.github.dfornika/nes-cljs {:local/root "../../../nes-cljs"}}
                  :extra-paths ["test/cljc"]}
           :test-node {:extra-paths ["test/cljs"]
                       :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.4"}}}
           ;; The .cljc tests again, on the JVM (npm run test:jvm): the code
           ;; that isn't tied to the browser has to work in both places.
           :test-jvm {:extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                      :main-opts ["-m" "cognitect.test-runner" "-d" "test/cljc"]}}}
