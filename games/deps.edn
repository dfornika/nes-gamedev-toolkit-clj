;; Not a project: the one classpath the games' ClojureScript tests run on
;; (npm run test:node, from here). Each game's own tests live in its test/
;; folder; they all run here, in one Node build, on zeropage's CPU
;; (zeropage.cpu, through zeropage.harness). nes-cljs is here for the few
;; tests that check a game the way the emulator reads it (nes.rom, nes.inspect.overlay).
{:paths ["../libs/zeropage/test/cljs"
         "catch/test/cljs" "hello/test/cljs" "hopper/test/cljs" "tower/test/cljs"
         "star-run/test/cljs" "ladder/test/cljs" "alienscape/test/cljs"]
 :deps {io.github.dfornika/zeropage {:local/root "../libs/zeropage"}
        io.github.dfornika/cartridj {:local/root "../libs/cartridj"}
        io.github.dfornika/catch {:local/root "catch"}
        io.github.dfornika/hello {:local/root "hello"}
        io.github.dfornika/hopper {:local/root "hopper"}
        io.github.dfornika/tower {:local/root "tower"}
        io.github.dfornika/star-run {:local/root "star-run"}
        io.github.dfornika/ladder {:local/root "ladder"}
        io.github.dfornika/alienscape {:local/root "alienscape"}
        io.github.dfornika/platform-kit {:local/root "platform-kit"}
        io.github.dfornika/poco {:local/root "poco"}
        io.github.dfornika/nes-cljs {:local/root "../../nes-cljs"}
        org.clojure/test.check {:mvn/version "1.1.1"}
        thheller/shadow-cljs {:mvn/version "3.5.4"}}
 :aliases
 ;; The :app build: nes-cljs's app with the toolkit beside it (npm run dev).
 ;; nes-cljs's own dev code (Portal) comes from its src/dev, and its
 ;; resources (index.html, CSS, the sample ROMs) from its deps.edn.
 {:app {:extra-paths ["target/app" "dev" "../../nes-cljs/src/dev"]
        :extra-deps {binaryage/devtools {:mvn/version "1.0.7"}
                     djblue/portal {:mvn/version "0.65.0"}}}}}
