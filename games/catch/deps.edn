{:paths ["src/cljc"]
 :deps {io.github.dfornika/zeropage {:local/root "../../libs/zeropage"}
        io.github.dfornika/cartridj {:local/root "../../libs/cartridj"}}
 :aliases
 {:test-jvm {:extra-paths ["test/cljc"]
             :extra-deps {io.github.dfornika/nes-cljs {:local/root "../../../nes-cljs"}
                          io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
             :main-opts ["-m" "cognitect.test-runner" "-d" "test/cljc"]}
  :dev {:extra-paths ["../dev"]
        :extra-deps {io.github.dfornika/nes-cljs {:local/root "../../../nes-cljs"}
                     thheller/shadow-cljs {:mvn/version "3.5.4"}
                     binaryage/devtools {:mvn/version "1.0.7"}
                     ;; data browser for tap> (dev builds only)
                     djblue/portal {:mvn/version "0.65.0"}}}
  :build {:paths ["src/cljc"]
          :deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 io.github.dfornika/catch {:local/root "."}}
          :ns-default build}}}