;; The background: its tiles (16x16 blocks, "metatiles") and the colors they're
;; drawn in (poco.art). Each is a cell of a tilesheet (a PNG, drawn in a pixel editor:
;; see :sheets) in the colors of its palette (palettes.edn), with what it's like to
;; walk into, its :kind (:empty if it's missing: see cartridj.screen/kinds). Run
;; `clojure -T:build tiles` after drawing, to read the PNG (into sheets.edn). Transparent
;; pixels show the backdrop color. A background tile can't be see-through, so :over says
;; which tile shows through where it would be. (A tile can also be drawn right here,
;; with :pixels: see cartridj.assets.) Their order here is their order in the
;; cartridge's graphics.
{:backdrop :green
 ;; the four palettes a room is drawn in, in order: a metatile's :palette is one of these
 :palettes [:grass :trees :water :wood]

 :sheets {:outdoors {:png "tiles/outdoors.png" :cell [16 16]}}

 :metatiles
 [
  {:id :grass, :palette :grass
   :source {:sheet :outdoors, :cell [0 0]}}

  {:id :flowers, :palette :grass
   :source {:sheet :outdoors, :cell [1 0]}}

  {:id :tree, :palette :trees, :kind :solid
   :source {:sheet :outdoors, :cell [2 0]}}

  {:id :water, :palette :water, :kind :solid
   :source {:sheet :outdoors, :cell [3 0]}}

  {:id :path, :palette :wood
   :source {:sheet :outdoors, :cell [4 0]}}

  {:id :brick, :palette :wood, :kind :solid
   :source {:sheet :outdoors, :cell [5 0]}}

  {:id :door, :palette :wood, :kind :door
   :source {:sheet :outdoors, :cell [6 0]}}

  {:id :floor, :palette :wood
   :source {:sheet :outdoors, :cell [7 0]}}

  ;; the stick on the floor of the house (see-through where the floor shows)
  {:id :stick, :palette :wood, :over :floor, :kind :pickup
   :source {:sheet :outdoors, :cell [0 1]}}

  ;; a sign in the grass
  {:id :sign, :palette :grass, :over :grass, :kind :sign
   :source {:sheet :outdoors, :cell [1 1]}}
 ]}
